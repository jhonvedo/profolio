---
import { supported, type Lang } from "./i18n";
const { lang } = Astro.props as { lang: Lang };
---

<div class="switch" role="group" aria-label="Language">
    {
        supported.map((l) => (
            <a href={`/${l}`} class:list={["opt", { on: l === lang }]} aria-current={l === lang ? "page" : undefined} hreflang={l}>
                {l.toUpperCase()}
            </a>
        ))
    }
</div>

<style>
    .switch {
        display: flex;
        background: var(--surface-2);
        border-radius: 100px;
        padding: 3px;
    }
    .opt {
        padding: 5px 10px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 800;
        color: var(--ink-3);
    }
    .opt:hover {
        color: var(--ink-2);
    }
    .opt.on {
        background: var(--surface);
        color: var(--primary);
        box-shadow: var(--sh-sm);
    }
</style>
