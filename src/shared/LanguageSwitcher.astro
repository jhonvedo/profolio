---
import { supported, type Lang } from "./i18n";
const { lang } = Astro.props as { lang: Lang };
---

<div class="switch" role="group" aria-label="Language">
    {
        supported.map((l, i) => (
            <>
                {i > 0 && <span class="sep">/</span>}
                <a href={`/${l}`} class:list={["opt", { on: l === lang }]} aria-current={l === lang ? "page" : undefined} hreflang={l}>
                    {l.toUpperCase()}
                </a>
            </>
        ))
    }
</div>

<style>
    .switch {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: var(--font-mono);
        font-size: 12.5px;
    }
    .sep {
        color: rgba(22, 21, 15, 0.3);
    }
    .opt {
        color: var(--muted-3);
    }
    .opt:hover {
        color: var(--accent);
    }
    .opt.on {
        color: var(--ink);
    }
</style>
