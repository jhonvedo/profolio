---
import Base from "../../../layouts/Base.astro";
import LanguageSwitcher from "../../../shared/LanguageSwitcher.astro";
import { supported, type Lang } from "../../../shared/i18n";
import { series, partHref, type Series, type Part } from "../../../shared/posts";
import "../../../styles/post.css";

const contents = import.meta.glob<string>("../../../content/posts/*/*/*.html", { query: "?raw", import: "default", eager: true });

export const getStaticPaths = () =>
    series.flatMap((s) =>
        supported.flatMap((lang) =>
            s.langs[lang].parts.map((part, index) => ({
                params: { lang, slug: `${s.langs[lang].slug}${part.slug ? `/${part.slug}` : ""}` },
                props: { s, lang, part, index },
            })),
        ),
    );

const { s, lang, part, index } = Astro.props as { s: Series; lang: Lang; part: Part; index: number };
const parts = s.langs[lang].parts;
const isIndex = index === 0;
const prev = parts[index - 1];
const next = parts[index + 1];
const hrefs = Object.fromEntries(supported.map((l) => [l, partHref(s, l, s.langs[l].parts[index])]));

const t = {
    es: { series: "Serie", part: "Parte", of: "de", read: "min de lectura", map: "Mapa de aprendizaje", mapHint: "Sigue el camino de arriba hacia abajo. Cada tema lleva a su sección; márcalo cuando lo domines.", examples: "Ejemplos para:", prev: "Anterior", next: "Siguiente", index: "← Índice de la serie", chapters: "capítulos", chapter: "Capítulo", topic: "Tema", optional: "Opcional", done: "Visto", mark: "Marcar como visto", progress: "temas vistos", pct: "hecho" },
    en: { series: "Series", part: "Part", of: "of", read: "min read", map: "Learning map", mapHint: "Follow the path from top to bottom. Each topic takes you to its section; check it off once you've got it.", examples: "Examples for:", prev: "Previous", next: "Next", index: "← Series index", chapters: "chapters", chapter: "Chapter", topic: "Topic", optional: "Optional", done: "Done", mark: "Mark as done", progress: "topics done", pct: "done" },
}[lang];

// Secciones (h2) de cada parte: les da un id si no tienen y las devuelve como temas del mapa de aprendizaje.
const slugify = (text: string) =>
    text.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const decode = (text: string) => text.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&amp;/g, "&");
const sections = (raw: string) => {
    const used = new Set<string>();
    const topics: { id: string; label: string }[] = [];
    const out = raw.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_, attrs: string, inner: string) => {
        const text = decode(inner.replace(/<[^>]+>/g, "")).trim();
        const own = attrs.match(/id="([^"]+)"/)?.[1];
        let id = own ?? (attrs.includes("practice-h") ? "practica" : slugify(text));
        for (let n = 2; !own && used.has(id); n++) id = `${slugify(text)}-${n}`;
        used.add(id);
        // Etiqueta corta: lo que va antes de ": ", sin contar los dos puntos dentro de <code>
        const short = decode(inner.replace(/<code>[\s\S]*?<\/code>/g, (c) => c.replace(/:/g, "\u0000")).replace(/<[^>]+>/g, ""))
            .trim()
            .split(/:\s/)[0]
            .replace(/\u0000/g, ":");
        if (!/^(Fuentes|Sources)$/.test(text)) topics.push({ id, label: short });
        return `<h2${own ? attrs : `${attrs} id="${id}"`}>${inner}</h2>`;
    });
    return { html: out, topics };
};
const sourceOf = (p: Part) => contents[`../../../content/posts/${s.id}/${lang}/${p.id}.html`];
// El índice solo muestra el mapa de aprendizaje; los capítulos muestran su contenido
const { html } = isIndex ? { html: "" } : sections(sourceOf(part));

// Mapa de aprendizaje (solo en el índice): etapas → capítulos → temas
const roadmap = isIndex
    ? s.stages.map((stage) => ({
          title: stage.title[lang],
          parts: stage.parts.map((id) => {
              const i = parts.findIndex((p) => p.id === id);
              const p = parts[i];
              const href = partHref(s, lang, p);
              return {
                  n: String(i).padStart(2, "0"),
                  title: p.title,
                  lede: p.lede,
                  minutes: p.minutes,
                  href,
                  optional: stage.optional?.includes(id) ?? false,
                  topics: sections(sourceOf(p)).topics.map((topic) => ({ ...topic, href: `${href}#${topic.id}`, key: `${id}:${topic.id}` })),
              };
          }),
      }))
    : [];
const topicCount = roadmap.reduce((sum, stage) => sum + stage.parts.reduce((n, p) => n + p.topics.length, 0), 0);
const title = isIndex ? s.title[lang] : part.title;
---

<Base lang={lang} noindex title={`${title} · Jhon Acevedo`} description={part.lede}>
    <Fragment slot="head">
        <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..800;1,300..600&family=DM+Mono:wght@400;500&display=swap`} />
        {supported.map((l) => <link rel="alternate" hreflang={l} href={hrefs[l]} />)}
    </Fragment>

    <div class="post-nav">
        <div class="post-nav-in">
            <a href={`/${lang}`} class="post-brand">Jhon Acevedo</a>
            <LanguageSwitcher lang={lang} hrefs={hrefs} />
        </div>
    </div>

    <article class="post" data-lang={lang}>
        <div class="post-wrap">
            <header class="post-head">
                {
                    isIndex ? (
                        <div class="post-kicker">{s.eyebrow[lang]}</div>
                    ) : (
                        <>
                            <div class="post-series">
                                <a href={partHref(s, lang, parts[0])}>{s.title[lang]}</a> · {t.part} {index} {t.of} {parts.length - 1}
                            </div>
                            <div class="post-kicker">{part.kicker}</div>
                        </>
                    )
                }
                <h1>{title}</h1>
                <p class="post-lede">{part.lede}</p>
                <div class="post-meta">
                    {isIndex ? (
                        <span>
                            {parts.length - 1} {t.chapters} · {parts.slice(1).reduce((sum, p) => sum + p.minutes, 0)} {t.read}
                        </span>
                    ) : (
                        <span>
                            {part.minutes} {t.read}
                        </span>
                    )}
                    {part.pills.map((p) => <span>{p}</span>)}
                </div>
            </header>

            {
                part.hasStack && (
                    <div class="stack-bar">
                        <span id="stack-label">{t.examples}</span>
                        <div class="seg" role="group" aria-labelledby="stack-label">
                            <button type="button" data-set-stack="dotnet" aria-pressed="true">
                                .NET / C#
                            </button>
                            <button type="button" data-set-stack="node" aria-pressed="false">
                                Node / TypeScript
                            </button>
                        </div>
                    </div>
                )
            }

            <div class="post-body">
                {
                    isIndex && (
                        <>
                            <section class="rm" aria-labelledby="rm-h">
                                <h2 id="rm-h">{t.map}</h2>
                                <p class="rm-hint">{t.mapHint}</p>
                                <div class="rm-top">
                                    <div class="rm-progress">
                                        <div class="rm-bar" aria-hidden="true">
                                            <span />
                                        </div>
                                        <span class="rm-count" data-pct={t.pct} data-label={t.progress}>
                                            <b>0%</b> {t.pct} · 0 / {topicCount} {t.progress}
                                        </span>
                                    </div>
                                    <ul class="rm-legend" aria-hidden="true">
                                        <li><i class="lg-main" />{t.chapter}</li>
                                        <li><i class="lg-sub" />{t.topic}</li>
                                        <li><i class="lg-opt" />{t.optional}</li>
                                        <li><i class="lg-done" />{t.done}</li>
                                    </ul>
                                </div>
                                <div class="rm-flow">
                                    {roadmap.map((stage, si) => (
                                        <div class="rm-stage">
                                            <h3 class="rm-stage-h">
                                                <span>{si + 1}</span>
                                                {stage.title}
                                            </h3>
                                            {stage.parts.map((p, pi) => (
                                                <div class:list={["rm-row", { optional: p.optional }]} data-side={(si + pi) % 2 ? "left" : "right"}>
                                                    <a class="rm-node" href={p.href} title={p.lede}>
                                                        <span class="rm-n">{p.n}</span>
                                                        <span class="rm-title">{p.title}</span>
                                                        <span class="rm-meta">
                                                            {p.optional && <>{t.optional} · </>}
                                                            {p.minutes} min · <b class="rm-done-n">0</b>/{p.topics.length}
                                                        </span>
                                                    </a>
                                                    <ul class="rm-subs">
                                                        {p.topics.map((topic) => (
                                                            <li>
                                                                <input type="checkbox" data-topic={topic.key} aria-label={`${t.mark}: ${topic.label}`} />
                                                                <a href={topic.href}>{topic.label}</a>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            ))}
                                        </div>
                                    ))}
                                </div>
                            </section>
                        </>
                    )
                }
                <Fragment set:html={html} />
            </div>

            <footer class="post-foot">
                <a class="index-link" href={partHref(s, lang, parts[0])}>{t.index}</a>
                <nav class="pager" aria-label={t.series}>
                    {
                        prev && (
                            <a class="prev" href={partHref(s, lang, prev)}>
                                <small>← {t.prev}</small>
                                <b>{index === 1 ? s.title[lang] : prev.title}</b>
                            </a>
                        )
                    }
                    {
                        next && (
                            <a class="next" href={partHref(s, lang, next)}>
                                <small>{t.next} →</small>
                                <b>{next.title}</b>
                            </a>
                        )
                    }
                </nav>
            </footer>
        </div>
    </article>
</Base>

<script>
    import { quizzes } from "../../../content/posts/claude-desde-0/quiz";

    const post = document.querySelector<HTMLElement>(".post");
    if (post) {
        const lang = (post.dataset.lang === "en" ? "en" : "es") as "es" | "en";
        const t = {
            es: { copy: "Copiar", copied: "Copiado", more: "Ver todo el código", less: "Ver menos", quiz: "Autoevaluación", ok: "Correcto. ", bad: "No es esa. ", reset: "Reiniciar" },
            en: { copy: "Copy", copied: "Copied", more: "Show all the code", less: "Show less", quiz: "Self-assessment", ok: "Correct. ", bad: "Not that one. ", reset: "Reset" },
        }[lang];
        const store = (k: string, v: string) => {
            try {
                localStorage.setItem(k, v);
            } catch {}
        };
        const load = (k: string) => {
            try {
                return localStorage.getItem(k);
            } catch {
                return null;
            }
        };

        // Stack (.NET / Node): se recuerda entre posts
        const setStack = (s: string) => {
            post.classList.remove("stack-dotnet", "stack-node");
            post.classList.add(`stack-${s}`);
            post.querySelectorAll<HTMLButtonElement>("[data-set-stack]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.setStack === s)));
            store("cc-guide-stack", s);
        };
        setStack(load("cc-guide-stack") === "node" ? "node" : "dotnet");
        post.querySelectorAll<HTMLButtonElement>("[data-set-stack]").forEach((b) => b.addEventListener("click", () => setStack(b.dataset.setStack!)));

        // Código: copiar y recortar los bloques largos
        post.querySelectorAll<HTMLElement>(".code").forEach((box) => {
            const pre = box.querySelector("pre");
            const btn = box.querySelector<HTMLButtonElement>(".copy");
            if (!pre) return;
            if (btn) {
                btn.textContent = t.copy;
                btn.addEventListener("click", () => {
                    const code = pre.querySelector("code")!.cloneNode(true) as HTMLElement;
                    const inactive = post.classList.contains("stack-node") ? "dotnet" : "node";
                    code.querySelectorAll(`[data-stack="${inactive}"]`).forEach((n) => n.remove());
                    navigator.clipboard?.writeText(code.textContent ?? "").then(() => {
                        btn.textContent = t.copied;
                        setTimeout(() => (btn.textContent = t.copy), 1400);
                    });
                });
            }
            const lines = pre.textContent!.replace(/\s+$/, "").split("\n").length;
            if (lines <= 16) return;
            box.classList.add("clipped");
            const more = document.createElement("button");
            more.type = "button";
            more.className = "more";
            more.textContent = `${t.more} (${lines})`;
            more.addEventListener("click", () => {
                const open = box.classList.toggle("clipped");
                more.textContent = open ? `${t.more} (${lines})` : t.less;
            });
            box.appendChild(more);
        });

        // Checklists: el progreso se guarda en el navegador y se comparte entre posts e idiomas
        let saved: Record<string, boolean> = {};
        try {
            saved = JSON.parse(load("cc-guide-checks") || "{}") || {};
        } catch {}
        post.querySelectorAll<HTMLElement>(".check").forEach((block) => {
            const boxes = block.querySelectorAll<HTMLInputElement>("input[type=checkbox]");
            const h = block.querySelector("h3");
            const count = document.createElement("span");
            count.className = "count";
            if (h) h.appendChild(count);
            else block.prepend(count);
            const refresh = () => {
                let n = 0;
                boxes.forEach((b) => {
                    if (b.checked) n++;
                    b.parentElement!.classList.toggle("done", b.checked);
                });
                count.textContent = `${n} / ${boxes.length}`;
            };
            boxes.forEach((b) => {
                b.checked = !!saved[b.id];
                b.addEventListener("change", () => {
                    saved[b.id] = b.checked;
                    store("cc-guide-checks", JSON.stringify(saved));
                    refresh();
                });
            });
            refresh();
        });

        // Mapa de aprendizaje: progreso por tema, guardado en el navegador
        const rm = post.querySelector<HTMLElement>(".rm");
        if (rm) {
            let seen: Record<string, boolean> = {};
            try {
                seen = JSON.parse(load("cc-roadmap") || "{}") || {};
            } catch {}
            const boxes = rm.querySelectorAll<HTMLInputElement>("input[data-topic]");
            const count = rm.querySelector<HTMLElement>(".rm-count")!;
            const refresh = () => {
                let n = 0;
                boxes.forEach((b) => {
                    b.parentElement!.classList.toggle("done", b.checked);
                    if (b.checked) n++;
                });
                rm.querySelectorAll<HTMLElement>(".rm-row").forEach((row) => {
                    const own = [...row.querySelectorAll<HTMLInputElement>("input[data-topic]")];
                    const c = own.filter((b) => b.checked).length;
                    row.querySelector(".rm-done-n")!.textContent = String(c);
                    row.classList.toggle("done", own.length > 0 && c === own.length);
                });
                const pct = boxes.length ? Math.round((100 * n) / boxes.length) : 0;
                count.innerHTML = `<b>${pct}%</b> ${count.dataset.pct} · ${n} / ${boxes.length} ${count.dataset.label}`;
                rm.querySelector<HTMLElement>(".rm-bar span")!.style.width = `${pct}%`;
            };
            boxes.forEach((b) => {
                b.checked = !!seen[b.dataset.topic!];
                b.addEventListener("change", () => {
                    seen[b.dataset.topic!] = b.checked;
                    store("cc-roadmap", JSON.stringify(seen));
                    refresh();
                });
            });
            refresh();
        }

        // Autoevaluación
        post.querySelectorAll<HTMLElement>("[data-quiz]").forEach((box) => {
            const list = quizzes[lang][box.dataset.quiz!];
            if (!list) return;
            const h = document.createElement("h3");
            h.textContent = t.quiz;
            box.appendChild(h);
            list.forEach((item, qi) => {
                const d = document.createElement("div");
                d.className = "q";
                const p = document.createElement("p");
                p.textContent = `${qi + 1}. ${item.q}`;
                const opts = document.createElement("div");
                opts.className = "opts";
                const why = document.createElement("div");
                why.className = "why";
                why.hidden = true;
                // Mezcla el orden de las opciones para que la posición no delate la respuesta
                const order = item.o.map((_, i) => i);
                for (let i = order.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [order[i], order[j]] = [order[j], order[i]];
                }
                order.forEach((oi) => {
                    const b = document.createElement("button");
                    b.type = "button";
                    b.textContent = item.o[oi];
                    b.dataset.correct = String(oi === item.a);
                    b.addEventListener("click", () => {
                        opts.querySelectorAll<HTMLButtonElement>("button").forEach((x) => {
                            x.disabled = true;
                            if (x.dataset.correct === "true") x.classList.add("ok");
                        });
                        if (oi !== item.a) b.classList.add("bad");
                        why.textContent = (oi === item.a ? t.ok : t.bad) + item.w;
                        why.hidden = false;
                    });
                    opts.appendChild(b);
                });
                d.append(p, opts, why);
                box.appendChild(d);
            });
            const r = document.createElement("button");
            r.type = "button";
            r.className = "reset";
            r.textContent = t.reset;
            r.addEventListener("click", () => {
                box.querySelectorAll<HTMLButtonElement>(".opts button").forEach((x) => {
                    x.disabled = false;
                    x.classList.remove("ok", "bad");
                });
                box.querySelectorAll<HTMLElement>(".why").forEach((w) => (w.hidden = true));
            });
            box.appendChild(r);
        });
    }
</script>

<style is:global>
    body {
        margin: 0;
        background: #f4f1ea;
    }
    .post-nav {
        --font-mono: "DM Mono", ui-monospace, monospace;
        --muted-3: #9a9689;
        background: #f4f1ea;
        border-bottom: 1px solid rgba(22, 21, 15, 0.12);
    }
    .post-nav-in {
        max-width: 860px;
        margin: 0 auto;
        padding: 14px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }
    .post-brand {
        font-family: "Hanken Grotesk", system-ui, sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: -0.2px;
        color: #16150f;
        text-decoration: none;
    }
    .post-brand:hover {
        color: #c8391a;
    }
    @media (max-width: 700px) {
        .post-nav-in {
            padding-inline: 18px;
        }
    }
</style>
