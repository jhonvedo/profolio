---
import Base from "../../layouts/Base.astro";
import "../../styles/globals.css";
import { getDictionary, isSupportedLang } from "../../shared/i18n";
import LanguageSwitcher from "../../shared/LanguageSwitcher.astro";
import CuotfyPhones from "../../shared/CuotfyPhones.astro";
export const getStaticPaths = () => [{ params: { lang: "es" } }, { params: { lang: "en" } }];
const langParam = Astro.params.lang;
const lang = isSupportedLang(langParam) ? langParam : "es";
const t = await getDictionary(lang);

const email = "contact@jhonacevedo.com";
const examples = t.hero.examples;
const mock = t.work.cuotfyMock;
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
    <header class="nav">
        <div class="wrap nav-in">
            <a href="#top" class="brand">Jhon Acevedo</a>
            <nav class="nav-links">
                {t.nav.map((n) => <a href={n.href}>{n.label}</a>)}
            </nav>
            <LanguageSwitcher lang={lang} />
        </div>
    </header>

    <main>
        <!-- HERO -->
        <section id="top" class="wrap hero">
            <div class="status reveal">
                <span class="status-dot"></span>
                <span>{t.hero.status}</span>
            </div>
            <div class="hero-grid">
                <h1 class="hero-name reveal" style="--d:80ms">Jhon<br />Acevedo</h1>
                <div class="hero-side reveal" style="--d:220ms">
                    <p class="statement">{t.hero.statement}</p>
                    <div class="terminal">
                        <div class="terminal-label">{t.hero.aiLabel}</div>
                        <div class="terminal-line">
                            <span class="prompt">&gt; </span><span id="typed">{examples[0].i}</span><span class="caret"></span>
                        </div>
                        <div class="terminal-result" id="typed-result-row">
                            <span class="prompt">→ </span><span id="typed-result">{examples[0].o}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hero-meta">
                <img class="photo" src="/img/profile.avif" alt={t.hero.photoAlt} width="180" height="225" />
                {
                    t.hero.meta.map((m) => (
                        <div class="meta-item">
                            <div class="meta-k">{m.k}</div>
                            <div class="meta-v">{m.v}</div>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- WORK -->
        <section id="trabajo" class="wrap work">
            <div class="section-head">
                <h2 class="h2">{t.work.heading}</h2>
                <span class="count">{t.work.count}</span>
            </div>
            {
                t.work.items.map((w) => (
                    <article class="case">
                        <div class="case-text">
                            <span class="case-n">{w.n}</span>
                            <div>
                                {w.url ? (
                                    <a href={w.url} target="_blank" rel="noopener" class="case-name">
                                        {w.name}
                                        <span class="arrow">↗</span>
                                    </a>
                                ) : (
                                    <span class="case-name">{w.name}</span>
                                )}
                                <div class="case-role">{w.role}</div>
                                <p class="case-desc">{w.desc}</p>
                                <div class="case-stack">{w.stack}</div>
                            </div>
                        </div>
                        <div class="case-media">
                            <div class="case-zoom">
                                {w.img ? (
                                    <img src={w.img} alt={w.name} loading="lazy" />
                                ) : (
                                    <CuotfyPhones mock={mock} />
                                )}
                            </div>
                        </div>
                    </article>
                ))
            }
        </section>

        <!-- WHAT I DO -->
        <section id="hago" class="dark">
            <div class="wrap do">
                <h2 class="h2 do-heading">{t.do.heading}</h2>
                <p class="do-lead">{t.do.lead}</p>
                <div class="do-grid">
                    {
                        t.do.items.map((d) => (
                            <div class="do-item">
                                <div class="do-n">{d.n}</div>
                                <div class="do-title">{d.title}</div>
                                <p class="do-desc">{d.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- EXPERIENCE -->
        <section id="experiencia" class="wrap exp">
            <div>
                <div class="kicker">{t.exp.kicker}</div>
                <p class="exp-statement">{t.exp.statement}</p>
            </div>
            <div>
                {
                    t.exp.companies.map((c) => (
                        <div class="company">
                            <span class="company-name">{c.name}</span>
                            <span class="company-years">{c.years}</span>
                        </div>
                    ))
                }
                <div class="sectors">{t.exp.sectors}</div>
            </div>
        </section>

        <!-- ABOUT -->
        <section id="sobre-mi" class="about">
            <div class="wrap about-in">
                <div class="kicker">{t.about.kicker}</div>
                <div class="about-text">
                    {t.about.paragraphs.map((p) => <p>{p}</p>)}
                </div>
            </div>
        </section>

        <!-- CONTACT -->
        <section id="contacto" class="contact">
            <div class="wrap contact-in">
                <div class="contact-kicker">{t.contact.kicker}</div>
                <a href={`mailto:${email}`} class="contact-email">{email}</a>
                <p class="contact-lead">{t.contact.lead}</p>
                <div class="contact-foot">
                    <div class="socials">
                        <a href="https://www.linkedin.com/in/jhonvedo/" target="_blank" rel="noopener">LinkedIn ↗</a>
                        <a href="https://github.com/jhonvedo" target="_blank" rel="noopener">GitHub ↗</a>
                    </div>
                    <span class="copy">© {new Date().getFullYear()} Jhon Acevedo · Medellín</span>
                </div>
            </div>
        </section>
    </main>

    <script is:inline define:vars={{ examples }}>
        (() => {
            const typed = document.getElementById("typed");
            const result = document.getElementById("typed-result");
            const row = document.getElementById("typed-result-row");
            if (!typed || !result || !row) return;
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                row.style.opacity = "1";
                return;
            }
            let ex = 0;
            let chars = 0;
            const show = (on) => (row.style.opacity = on ? "1" : "0");
            const start = () => {
                const cur = examples[ex];
                result.textContent = cur.o;
                typed.textContent = "";
                chars = 0;
                show(false);
                const timer = setInterval(() => {
                    chars++;
                    typed.textContent = cur.i.slice(0, chars);
                    if (chars < cur.i.length) return;
                    clearInterval(timer);
                    setTimeout(() => {
                        show(true);
                        setTimeout(() => {
                            ex = (ex + 1) % examples.length;
                            start();
                        }, 2600);
                    }, 450);
                }, 60);
            };
            start();
        })();
    </script>
</Base>

<style>
    .wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding-left: 32px;
        padding-right: 32px;
        box-sizing: border-box;
    }
    .prompt {
        color: var(--muted-3);
    }
    .kicker {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted-2);
        margin-bottom: 20px;
    }
    .h2 {
        font-size: clamp(32px, 4vw, 52px);
        font-weight: 600;
        letter-spacing: -0.035em;
        margin: 0;
    }

    /* NAV */
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(244, 241, 234, 0.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(22, 21, 15, 0.12);
    }
    .nav-in {
        padding-top: 16px;
        padding-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }
    .brand {
        font-weight: 700;
        font-size: 15px;
        letter-spacing: -0.2px;
    }
    .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
        flex-wrap: wrap;
    }
    .nav-links a {
        font-size: 14px;
        color: var(--muted);
    }
    .nav-links a:hover {
        color: var(--accent);
    }

    /* HERO */
    .hero {
        padding-top: 64px;
        padding-bottom: 96px;
    }
    .reveal {
        animation: reveal 800ms var(--ease-out) var(--d, 0ms) both;
    }
    @keyframes reveal {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
    }
    .status {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 28px;
    }
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 100px;
        background: var(--accent);
        display: inline-block;
    }
    .hero-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
        gap: 40px 64px;
        align-items: end;
        margin-bottom: 64px;
    }
    .hero-name {
        font-size: clamp(64px, 10vw, 152px);
        font-weight: 700;
        line-height: 0.9;
        letter-spacing: -0.045em;
        margin: 0;
    }
    .hero-side {
        display: flex;
        flex-direction: column;
        gap: 28px;
        padding-bottom: 10px;
    }
    .statement {
        font-size: clamp(21px, 2vw, 27px);
        line-height: 1.35;
        letter-spacing: -0.02em;
        margin: 0;
        text-wrap: pretty;
    }
    .terminal {
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 14px 0;
        font-family: var(--font-mono);
        font-size: 13.5px;
        line-height: 1.7;
    }
    .terminal-label {
        color: var(--accent);
        font-size: 11.5px;
        margin-bottom: 6px;
    }
    .terminal-line {
        min-height: 23px;
    }
    .caret {
        display: inline-block;
        width: 8px;
        height: 15px;
        background: var(--ink);
        vertical-align: -2px;
        margin-left: 2px;
        animation: caret 1s steps(1) infinite;
    }
    @keyframes caret {
        50% {
            opacity: 0;
        }
    }
    .terminal-result {
        color: var(--muted);
        min-height: 23px;
        transition: opacity 300ms ease;
    }
    .hero-meta {
        border-top: 1px solid var(--ink);
        padding-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 32px 56px;
        align-items: flex-end;
    }
    .photo {
        width: 180px;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        display: block;
    }
    .meta-item {
        min-width: 160px;
    }
    .meta-k {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--muted-2);
        margin-bottom: 4px;
    }
    .meta-v {
        font-size: 16px;
        line-height: 1.4;
    }

    /* WORK */
    .work {
        padding-bottom: 120px;
    }
    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 40px;
    }
    .count {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted-2);
    }
    .case {
        border-top: 1px solid var(--line);
        padding: 36px 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
        gap: 40px;
        align-items: start;
    }
    .case-text {
        display: grid;
        grid-template-columns: 56px minmax(0, 1fr);
        gap: 8px;
    }
    .case-n {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--accent);
        padding-top: 10px;
    }
    .case-name {
        font-size: clamp(28px, 3vw, 40px);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
        display: inline-flex;
        gap: 10px;
        align-items: baseline;
        margin-bottom: 6px;
        color: var(--ink);
        transition: color 250ms ease;
    }
    .arrow {
        display: inline-block;
        font-size: 0.7em;
        transition: transform 300ms var(--ease-out);
    }
    .case:hover .case-name {
        color: var(--accent);
    }
    .case:hover .arrow {
        transform: translate(3px, -3px);
    }
    .case-role {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted-2);
        margin-bottom: 20px;
    }
    .case-desc {
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink-3);
        margin: 0 0 20px;
        max-width: 520px;
        text-wrap: pretty;
    }
    .case-stack {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted);
    }
    .case-media {
        overflow: hidden;
        background: #eae6dc;
    }
    .case-zoom {
        transition: transform 700ms var(--ease-out);
    }
    .case:hover .case-zoom {
        transform: scale(1.035);
    }
    .case-zoom img {
        width: 100%;
        aspect-ratio: 16 / 10;
        display: block;
        object-fit: contain;
        padding: 28px;
        box-sizing: border-box;
    }
    /* WHAT I DO */
    .dark {
        background: var(--ink);
        color: var(--paper);
    }
    .do {
        padding-top: 112px;
        padding-bottom: 112px;
    }
    .do-heading {
        margin-bottom: 20px;
        max-width: 820px;
        text-wrap: balance;
    }
    .do-lead {
        font-size: 18px;
        line-height: 1.6;
        color: rgba(244, 241, 234, 0.7);
        margin: 0 0 64px;
        max-width: 620px;
    }
    .do-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
        gap: 40px;
    }
    .do-item {
        border-top: 1px solid rgba(244, 241, 234, 0.25);
        padding-top: 22px;
    }
    .do-n {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--accent-soft);
        margin-bottom: 14px;
    }
    .do-title {
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 12px;
    }
    .do-desc {
        font-size: 15.5px;
        line-height: 1.65;
        color: rgba(244, 241, 234, 0.72);
        margin: 0;
    }

    /* EXPERIENCE */
    .exp {
        padding-top: 120px;
        padding-bottom: 120px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
        gap: 56px;
    }
    .exp-statement {
        font-size: clamp(26px, 3vw, 40px);
        line-height: 1.2;
        letter-spacing: -0.03em;
        font-weight: 500;
        margin: 0;
        text-wrap: pretty;
    }
    .company {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        border-top: 1px solid var(--line-soft);
        padding: 16px 0;
    }
    .company-name {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.01em;
    }
    .company-years {
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--muted-2);
        white-space: nowrap;
    }
    .sectors {
        border-top: 1px solid var(--line-soft);
        padding-top: 18px;
        font-size: 14.5px;
        color: var(--muted);
        line-height: 1.6;
    }

    /* ABOUT */
    .about {
        border-top: 1px solid var(--line-soft);
    }
    .about-in {
        padding-top: 112px;
        padding-bottom: 112px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        gap: 56px;
        align-items: start;
    }
    .about-text {
        max-width: 760px;
    }
    .about-text p {
        font-size: clamp(19px, 1.8vw, 23px);
        line-height: 1.55;
        letter-spacing: -0.01em;
        margin: 0 0 24px;
        color: var(--ink-2);
        text-wrap: pretty;
    }
    @media (max-width: 760px) {
        .about-in {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }

    /* CONTACT */
    .contact {
        background: var(--accent);
        color: var(--on-accent);
    }
    .contact-in {
        padding-top: 112px;
        padding-bottom: 48px;
    }
    .contact a {
        color: var(--on-accent);
    }
    .contact a:hover {
        color: var(--ink);
    }
    .contact-kicker {
        font-family: var(--font-mono);
        font-size: 13px;
        color: rgba(255, 248, 242, 0.8);
        margin-bottom: 24px;
    }
    .contact-email {
        display: inline-block;
        font-size: clamp(34px, 6.4vw, 96px);
        font-weight: 600;
        letter-spacing: -0.045em;
        line-height: 1;
        margin-bottom: 28px;
        word-break: break-word;
    }
    .contact-lead {
        font-size: 19px;
        line-height: 1.55;
        max-width: 560px;
        margin: 0 0 80px;
    }
    .contact-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        border-top: 1px solid rgba(255, 248, 242, 0.35);
        padding-top: 24px;
    }
    .socials {
        display: flex;
        gap: 28px;
        flex-wrap: wrap;
        font-size: 15px;
    }
    .copy {
        font-family: var(--font-mono);
        font-size: 12px;
        color: rgba(255, 248, 242, 0.8);
    }

    @media (max-width: 600px) {
        .wrap {
            padding-left: 20px;
            padding-right: 20px;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .reveal,
        .caret {
            animation: none;
        }
    }
</style>
