---
import Base from "../../layouts/Base.astro";
import "../../styles/globals.css";
import { getDictionary, isSupportedLang } from "../../shared/i18n";
import LanguageSwitcher from "../../shared/LanguageSwitcher.astro";
export const getStaticPaths = () => [{ params: { lang: "es" } }, { params: { lang: "en" } }];
const langParam = Astro.params.lang;
const lang = isSupportedLang(langParam) ? langParam : "es";
const t = await getDictionary(lang);

const contact = {
    email: "contact@jhonacevedo.com",
    linkedin: "https://www.linkedin.com/in/jhonvedo/",
    linkedinLabel: "linkedin.com/in/jhonvedo",
    github: "https://github.com/jhonvedo",
    githubLabel: "github.com/jhonvedo",
};
const f = t.cases.featured;
const m = f.mock;

const icon = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const sparkle = icon('<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 3v4M17 5h4"/><circle cx="5" cy="19" r="1.5"/>');
const navIcons = [
    icon('<path d="M4 11l8-7 8 7v9a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>'),
    icon('<rect x="3" y="6" width="18" height="14" rx="2"/><path d="M3 10h18M16 15h2"/>'),
    sparkle,
    icon('<path d="M4 4v16h16M8 16v-4M12 16V8M16 16v-6"/>'),
    icon('<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>'),
];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
    <!-- NAV -->
    <header class="nav">
        <div class="wrap nav-in">
            <a href={`/${lang}`} class="brand">
                <span class="brand-dot"></span>
                jhon acevedo
            </a>
            <nav class="nav-links">
                {t.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </nav>
            <div class="nav-right">
                <LanguageSwitcher lang={lang} />
                <a href="#contacto" class="nav-cta">{t.nav.cta}</a>
            </div>
        </div>
    </header>

    <main>
        <!-- HERO -->
        <section class="hero">
            <div class="wrap hero-grid">
                <div>
                    <div class="pill">
                        <span class="pill-dot"></span>
                        <span>{t.hero.kicker}</span>
                    </div>
                    <div class="whoami">$ whoami</div>
                    <h1 class="hero-title">{t.hero.title}</h1>
                    <p class="hero-sub">{t.hero.subtitle}</p>
                    <div class="row" style="margin-bottom:32px;">
                        <a href="#contacto" class="btn-light">{t.hero.ctaPrimary}</a>
                        <a href="#proyectos" class="btn-ghost">{t.hero.ctaSecondary}</a>
                    </div>
                    <div class="row" style="gap:10px;">
                        {t.hero.badges.map((b) => <span class="hero-badge">{b}</span>)}
                    </div>
                </div>
                <div class="hero-photo">
                    <img src="/img/profile.avif" alt={t.hero.photoAlt} width="220" height="220" />
                    <span class="loc">📍 {t.hero.location}</span>
                </div>
            </div>
        </section>

        <!-- SERVICIOS -->
        <section id="servicios" class="wrap section">
            <div class="head">
                <div class="kicker">{t.services.kicker}</div>
                <h2 class="h2">{t.services.heading}</h2>
                <p class="lead">{t.services.subheading}</p>
            </div>
            <div class="grid" style="--min:240px;">
                {
                    t.services.items.map((svc) => (
                        <div class="card" style="padding:22px;">
                            <div class="card-title">{svc.title}</div>
                            <div class="card-desc">{svc.desc}</div>
                            {svc.bullets.map((b) => (
                                <div class="bullet">
                                    <span class="dot" />
                                    <span>{b}</span>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- CASOS -->
        <section id="proyectos" class="band">
            <div class="wrap">
                <div class="head">
                    <div class="kicker">{t.cases.kicker}</div>
                    <h2 class="h2">{t.cases.heading}</h2>
                    <p class="lead">{t.cases.subheading}</p>
                </div>

                <div class="featured">
                    <div class="featured-visual" role="img" aria-label={m.alt}>
                        <div class="phones" aria-hidden="true">
                            <!-- IA screen (back) -->
                            <div class="phone phone-back">
                                <div class="scr scr-ia">
                                    <div class="ia-tabs">
                                        <span class="on">{m.tab1}</span>
                                        <span>{m.tab2}</span>
                                    </div>
                                    <div class="ia-hero">
                                        <div class="ia-hero-top">
                                            <b>{m.iaTitle}</b>
                                            <span class="ia-chip">✦ Claude AI</span>
                                        </div>
                                        <p>{m.iaDesc}</p>
                                    </div>
                                    <div class="ia-box">
                                        <div class="ia-input">{m.input}<span class="caret"></span></div>
                                        {m.examples.map((ex) => <div class="ia-ex">{ex}</div>)}
                                        <div class="ia-btn"><Fragment set:html={sparkle} /> {m.button}</div>
                                    </div>
                                    <div class="ia-result">
                                        <div>
                                            <div class="ia-result-cat">{m.resultCat}</div>
                                            <div class="ia-result-name">{m.resultName}</div>
                                        </div>
                                        <div class="ia-result-amt">{m.resultAmt}</div>
                                    </div>
                                </div>
                                <div class="tabbar">
                                    {m.nav.map((n, i) => <span class:list={{ on: i === 2, ai: i === 2 }}><Fragment set:html={navIcons[i]} />{n}</span>)}
                                </div>
                            </div>

                            <!-- Home screen (front) -->
                            <div class="phone phone-front">
                                <div class="scr">
                                    <div class="home-head">
                                        <div class="home-top">
                                            <span class="home-logo"><i></i>cuotfy</span>
                                            <span class="home-avatar">JA</span>
                                        </div>
                                        <div class="home-hi">{m.greeting}</div>
                                        <div class="home-label">{m.totalLabel}</div>
                                        <div class="home-total">{m.total}</div>
                                        <div class="home-label" style="margin-top:8px;">{m.month}</div>
                                        <div class="home-kpis">
                                            <div><span class="k-dot" style="background:var(--g500);"></span>{m.income}<b>{m.incomeVal}</b></div>
                                            <div><span class="k-dot" style="background:#ef4444;"></span>{m.expense}<b>{m.expenseVal}</b></div>
                                        </div>
                                    </div>
                                    <div class="home-body">
                                        <div class="home-ask">
                                            <Fragment set:html={sparkle} />
                                            <div><b>{m.askTitle}</b><span>{m.askSub}</span></div>
                                            <em>›</em>
                                        </div>
                                        <div class="home-quick-label">{m.quick}</div>
                                        <div class="home-quick">
                                            <div><i></i><b>{m.quick1}</b><span>{m.quick1Sub}</span></div>
                                            <div><i></i><b>{m.quick2}</b><span>{m.quick2Sub}</span></div>
                                        </div>
                                        <div class="home-input">
                                            <Fragment set:html={sparkle} />
                                            <span>{m.input}</span>
                                            <em>➤</em>
                                        </div>
                                    </div>
                                </div>
                                <div class="tabbar">
                                    {m.nav.map((n, i) => <span class:list={{ on: i === 0 }}><Fragment set:html={navIcons[i]} />{n}</span>)}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="featured-body">
                        <div class="row" style="gap:8px;">
                            <span class="tag tag-ai">✦ Claude AI</span>
                            <span class="tag">{f.role}</span>
                        </div>
                        <div class="featured-name">{f.name}</div>
                        <div class="featured-desc">{f.desc}</div>
                        <div class="flow">
                            {
                                f.flow.map((step, i) => (
                                    <>
                                        <span class="flow-step">{step}</span>
                                        {i < f.flow.length - 1 && <span class="flow-arrow">→</span>}
                                    </>
                                ))
                            }
                        </div>
                        <div class="row" style="gap:6px;">
                            {f.tags.map((tag) => <span class="tag">{tag}</span>)}
                        </div>
                        <div class="row" style="gap:8px;flex-wrap:nowrap;">
                            {
                                f.stats.map((st) => (
                                    <div class="stat">
                                        <div class="stat-label">{st.label}</div>
                                        <div class="stat-value">{st.value}</div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="grid" style="--min:300px;gap:20px;">
                    {
                        t.cases.items.map((cs) => (
                            <article class="card case">
                                <a href={cs.url} target="_blank" rel="noopener noreferrer" class="case-img">
                                    <img src={cs.img} alt={cs.name} loading="lazy" />
                                </a>
                                <div style="padding:20px;">
                                    <a href={cs.url} target="_blank" rel="noopener noreferrer" class="case-name">
                                        {cs.name} <span aria-hidden="true">↗</span>
                                    </a>
                                    <div class="card-desc" style="font-size:13px;">
                                        {cs.desc}
                                    </div>
                                    <div class="row" style="gap:6px;margin-bottom:14px;">
                                        {cs.tags.map((tag) => (
                                            <span class="tag">{tag}</span>
                                        ))}
                                    </div>
                                    {cs.stats.length > 0 && (
                                        <div class="row" style="gap:8px;flex-wrap:nowrap;">
                                            {cs.stats.map((st) => (
                                                <div class="stat">
                                                    <div class="stat-label">{st.label}</div>
                                                    <div class="stat-value">{st.value}</div>
                                                </div>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- EXPERIENCIA -->
        <section id="experiencia" class="band" style="border-top:1px solid var(--border);">
            <div class="wrap">
                <div class="head" style="max-width:620px;">
                    <div class="kicker">{t.experience.kicker}</div>
                    <h2 class="h2" style="text-wrap:balance;">{t.experience.heading}</h2>
                    <p class="lead" style="text-wrap:pretty;">{t.experience.subheading}</p>
                </div>
                <div class="grid" style="--min:200px;margin-bottom:16px;">
                    {
                        t.experience.stats.map((st) => (
                            <div class="card" style="padding:22px;">
                                <div class="big-num">{st.value}</div>
                                <div class="card-desc" style="font-size:13px;line-height:1.5;margin:0;">
                                    {st.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
                <div class="grid" style="--min:300px;">
                    <div class="card" style="padding:22px;">
                        <div class="eyebrow">{t.experience.sectorsLabel}</div>
                        <div class="row" style="gap:8px;">
                            {t.experience.sectors.map((sec) => <span class="sector">{sec}</span>)}
                        </div>
                    </div>
                    <div class="card" style="padding:22px;">
                        <div class="eyebrow">{t.experience.companiesLabel}</div>
                        <div class="row" style="gap:8px 18px;align-items:baseline;">
                            {t.experience.companies.map((co) => <span class="company">{co}</span>)}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SOBRE MÍ -->
        <section id="sobre-mi" class="section">
            <div class="wrap about">
                <div class="about-photo">
                    <img src="/img/profile.avif" alt={t.hero.photoAlt} loading="lazy" />
                    <span class="coffee" aria-hidden="true">☕</span>
                </div>
                <div>
                    <div class="kicker">{t.about.kicker}</div>
                    <h2 class="h2" style="font-size:26px;margin-bottom:14px;">{t.about.heading}</h2>
                    <p class="lead" style="line-height:1.7;margin-bottom:18px;max-width:640px;">{t.about.bio}</p>
                    <div class="row" style="gap:8px;">
                        {t.about.values.map((v) => <span class="value">{v}</span>)}
                    </div>
                </div>
            </div>
        </section>

        <!-- BLOG -->
        <section id="blog" class="band">
            <div class="wrap">
            <div class="head">
                <div class="kicker">{t.blog.kicker}</div>
                <h2 class="h2">{t.blog.heading}</h2>
                <p class="lead">{t.blog.subheading}</p>
            </div>
            <div class="grid" style="--min:260px;">
                {
                    t.blog.items.map((post) => (
                        <div class="card" style="padding:20px;">
                            <span class="tag">{post.tag}</span>
                            <div class="card-title" style="font-size:15px;margin:12px 0 8px;">
                                {post.title}
                            </div>
                            <div class="card-desc" style="font-size:13px;margin:0;">
                                {post.excerpt}
                            </div>
                        </div>
                    ))
                }
            </div>
            </div>
        </section>

        <!-- CONTACTO -->
        <section id="contacto" class="wrap section">
            <div class="contact">
                <div>
                    <h2 class="h2" style="font-size:26px;color:#fff;">{t.contact.heading}</h2>
                    <p class="lead" style="color:rgba(255,255,255,0.75);margin-bottom:24px;max-width:440px;">{t.contact.subheading}</p>
                    <a href={`mailto:${contact.email}`} class="btn-light">{t.contact.cta}</a>
                </div>
                <div class="contact-list">
                    <div>
                        <div class="contact-label">{t.contact.emailLabel}</div>
                        <a href={`mailto:${contact.email}`}>{contact.email}</a>
                    </div>
                    <div>
                        <div class="contact-label">LinkedIn</div>
                        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">{contact.linkedinLabel}</a>
                    </div>
                    <div>
                        <div class="contact-label">GitHub</div>
                        <a href={contact.github} target="_blank" rel="noopener noreferrer">{contact.githubLabel}</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">{t.footer.text}</footer>
</Base>

<style>
    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }
    .section {
        padding: 72px 24px;
    }
    .band {
        background: var(--surface-2);
        padding: 72px 24px;
    }
    .head {
        max-width: 560px;
        margin-bottom: 36px;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
        gap: 16px;
    }

    /* nav */
    .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }
    .nav-in {
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 16px;
        color: var(--ink);
    }
    .brand:hover {
        color: var(--ink);
    }
    .brand-dot {
        width: 8px;
        height: 8px;
        border-radius: 100px;
        background: var(--primary);
    }
    .nav-links {
        display: flex;
        gap: 22px;
    }
    .nav-links a {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink-2);
    }
    .nav-links a:hover {
        color: var(--primary);
    }
    .nav-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .nav-cta {
        background: var(--primary);
        color: #fff;
        padding: 9px 16px;
        border-radius: 100px;
        font-size: 13px;
        font-weight: 700;
        box-shadow: var(--sh-pri);
        white-space: nowrap;
    }
    .nav-cta:hover {
        color: #fff;
        background: var(--g600);
    }

    /* hero */
    .hero {
        background: var(--hero-gradient);
        padding: 64px 24px 72px;
    }
    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(220px, 0.7fr);
        gap: 48px;
        align-items: center;
    }
    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 100px;
        padding: 6px 14px;
        margin-bottom: 20px;
        font-size: 12px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.85);
    }
    .pill-dot {
        width: 7px;
        height: 7px;
        border-radius: 100px;
        background: var(--g400);
        box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.2);
    }
    .whoami {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--g300);
        margin-bottom: 10px;
    }
    .hero-title {
        font-family: var(--font-display);
        font-size: 40px;
        font-weight: 800;
        line-height: 1.15;
        color: #fff;
        margin: 0 0 16px;
        letter-spacing: -0.5px;
    }
    .hero-sub {
        font-size: 16px;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.75);
        max-width: 560px;
        margin: 0 0 28px;
    }
    .hero-badge {
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: rgba(255, 255, 255, 0.75);
        font-size: 11.5px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 100px;
    }
    .hero-photo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }
    .hero-photo img {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    }
    .loc {
        font-family: var(--font-mono);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
    }

    /* cards */
    .card-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 15.5px;
        color: var(--ink);
        margin-bottom: 8px;
    }
    .card-desc {
        font-size: 13.5px;
        color: var(--ink-2);
        line-height: 1.55;
        margin-bottom: 14px;
    }
    .bullet {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        color: var(--ink-2);
        margin-bottom: 6px;
    }
    .bullet .dot {
        transform: none;
    }

    /* cases */
    .featured {
        background: var(--surface);
        border: 1px solid var(--ai-soft);
        border-radius: 20px;
        box-shadow: var(--sh-ai);
        overflow: hidden;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
        margin-bottom: 20px;
    }
    .featured-visual {
        min-height: 440px;
        background:
            radial-gradient(420px 260px at 85% 10%, rgba(124, 58, 237, 0.4), transparent 70%),
            var(--hero-gradient);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 24px;
        overflow: hidden;
    }

    /* phone mockups (based on the Cuotfy app screens) */
    .phones {
        position: relative;
        width: 384px;
        height: 420px;
        flex-shrink: 0;
    }
    .phone {
        position: absolute;
        width: 196px;
        height: 408px;
        border-radius: 30px;
        background: #0b120d;
        padding: 6px;
        box-shadow:
            0 24px 60px rgba(0, 0, 0, 0.45),
            inset 0 0 0 1px rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        font-family: var(--font-body);
        color: var(--ink);
    }
    .phone :global(svg) {
        width: 1em;
        height: 1em;
        flex-shrink: 0;
    }
    .phone-back {
        right: 0;
        top: 12px;
        transform: rotate(6deg);
    }
    .phone-front {
        left: 0;
        top: 0;
        transform: rotate(-4deg);
        z-index: 1;
    }
    .scr {
        flex: 1;
        background: #f6f8f5;
        border-radius: 24px 24px 0 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .tabbar {
        background: #fff;
        border-radius: 0 0 24px 24px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-around;
        padding: 6px 4px 8px;
    }
    .tabbar span {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        font-size: 5.5px;
        color: var(--ink-3);
    }
    .tabbar span :global(svg) {
        font-size: 11px;
    }
    .tabbar .on {
        color: var(--g700);
        font-weight: 700;
    }
    .tabbar .ai {
        color: var(--ai-mid);
    }

    /* home */
    .home-head {
        background: linear-gradient(160deg, #14532d 0%, #052e16 70%, #020a04 100%);
        padding: 14px 12px 12px;
        color: #fff;
    }
    .home-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .home-logo {
        display: flex;
        align-items: center;
        gap: 4px;
        font-weight: 800;
        font-size: 13px;
    }
    .home-logo i {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--g500);
    }
    .home-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--g600);
        font-size: 7px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .home-hi {
        font-size: 7.5px;
        color: var(--g400);
        margin: 6px 0 8px;
    }
    .home-label {
        font-size: 5.5px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--g400);
    }
    .home-total {
        font-family: var(--font-mono);
        font-size: 19px;
