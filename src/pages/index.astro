---
import Base from "@/layouts/Base.astro";
import "@/styles/globals.css";
---

<Base lang="es">
    <main style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:96px 24px;background:var(--hero-gradient);">
        <div style="text-align:center;">
            <h1 style="font-family:var(--font-display);font-size:28px;font-weight:800;color:#fff;margin:0;">Elige tu idioma · Choose your language</h1>
            <div style="margin-top:32px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                <a href="/es" class="btn-light">Español</a>
                <a href="/en" class="btn-ghost">English</a>
            </div>
        </div>
    </main>
</Base>
